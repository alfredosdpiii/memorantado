MEMORANTADO_PORT=3789
MEMORANTADO_DB=
# Store backend: sqlite (default) or pg (Postgres + pgvector)
MEMORANTADO_STORE=sqlite
# Required when MEMORANTADO_STORE=pg, e.g.
# postgres://<user>:<password>@127.0.0.1:55432/memorantado
MEMORANTADO_DATABASE_URL=
MEMORANTADO_ENABLE_METRICS=true
LOG_LEVEL=info
